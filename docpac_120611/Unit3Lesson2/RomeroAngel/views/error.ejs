<%- include('partials/header') %>

    <marquee width="60%" direction="right" height="100px" scrollamount="20">
        <h1 id="ERROR">Wow! Wow! Error Spotted!</h1>
    </marquee>
    <% if (statusCode===400) { %>
        <b>
            <p>Description For 400: You simply made the mistake of putting a space in the name area</p>
        </b>
        <% } else if (statusCode===404) { %>
            <b>
                <p>Description For 404: The page you're looking for doesn't exist!</p>
            </b>
            <% } %>


                <br>

                <h2>Here Are Button To Other Valid Pages</h2>

                <% Linksandstuff.forEach(link=> { %>
                    <button>
                        <a href="<%= link.url %>">
                            <%= link.text %>
                        </a>
                    </button>
                    <br>
                    <% }); %>


                        <%- include('partials/footer') %>