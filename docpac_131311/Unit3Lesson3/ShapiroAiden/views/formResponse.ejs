<%- include('partials/header', { title: title }) %>
<h1>Form Response</h1>
<% if (text) { %>
    <p>submitted text: <%= text %></p>
<% } else { %>
    <p>no text was submitted!!!</p>
<% } %>
<p><a href="/form">submit another!</a></p>
<h2>All Saved Entries</h2>
<% if (entries && entries.length > 0) { %>
    <ul>
        <% entries.forEach(function(entry) { %>
            <li>
                <strong>Value:</strong> <%= entry.value %>
                <strong>Source:</strong> <%= entry.source %>
                <strong>Created:</strong> <%= entry.created_at %>
            </li>
        <% }); %>
    </ul>
<% } else { %>
    <p>No entries have been saved yet.</p>
<% } %>

<%- include('partials/footer') %>
